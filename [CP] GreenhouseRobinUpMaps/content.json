    "Changes": [
        {
            "Action": "Load",
            "Target": "Maps/Greenhouse",
            "FromFile": "assets/Greenhouse_{{ghlevel}}.tmx",
            "When": {
                "query: {{ghlevel}} >= 0": true
            }//,
            //"Update": "OnLocationChange"
        }
    ]
}